let cart={};
let category="all";
let promoCategory="all";
const money=n=>"₱"+n.toFixed(2);

function showMenu(){
 const query=document.getElementById("search").value.toLowerCase();
 const filtered=products.filter(p=>(category==="all"||p[3]===category)&&p[1].toLowerCase().includes(query));
 document.getElementById("menuGrid").innerHTML=filtered.length?filtered.map(p=>`
 <article class="item">
 <div class="item-art"><small>${p[3].toUpperCase()}</small>${p[4]}</div>
 <div class="item-info"><h3>${p[1]}</h3><p>${p[5]?"Available choices and flavors:":"Friedays favorite. Add to your order!"}</p>
 ${p[5]?`<div class="flavors">${p[5]}</div>`:""}
 <div class="item-bottom"><span class="price">${money(p[2])}</span><button class="add" onclick="addItem('${p[0]}')">+ ADD</button></div></div>
 </article>`).join(""):'<div class="empty">No matching items. Try another search.</div>';
}

function addItem(id){cart[id]=(cart[id]||0)+1;showCart()}
function changeQty(id,n){cart[id]=(cart[id]||0)+n;if(cart[id]<=0)delete cart[id];showCart()}
function countItems(){return Object.values(cart).reduce((a,b)=>a+b,0)}
function totalPrice(){return products.reduce((s,p)=>s+(cart[p[0]]||0)*p[2],0)}
function showCart(){
 const selected=products.filter(p=>cart[p[0]]);
 document.getElementById("count").textContent=countItems()+" items";
 document.getElementById("total").textContent=money(totalPrice());
 document.getElementById("floatCount").textContent=countItems();
 document.getElementById("floatTotal").textContent=money(totalPrice());
 document.getElementById("floatCart").style.display=countItems()?"block":"none";
 document.getElementById("cartItems").innerHTML=selected.length?selected.map(p=>`
 <div class="cart-row"><div><strong>${p[1]}</strong><small>${money(p[2])} each</small></div>
 <div class="qty"><button type="button" onclick="changeQty('${p[0]}',-1)">−</button>${cart[p[0]]}<button type="button" onclick="changeQty('${p[0]}',1)">+</button></div>
 <span class="cart-line">${money(p[2]*cart[p[0]])}</span></div>`).join(""):'<div class="empty">Your cart is waiting for something delicious! 🍟</div>';
}

function showPromos(){
 const filtered=promos.filter(p=>promoCategory==="all"||p[2]===promoCategory);
 document.getElementById("promoGrid").innerHTML=filtered.map(p=>`
 <article class="promo-card"><span class="icon">${p[0]}</span><h3>${p[1]}</h3><p>${p[3]}</p><small>PROPOSED CAMPAIGN · SUBJECT TO OWNER APPROVAL</small></article>`).join("");
}

document.getElementById("tabs").addEventListener("click",e=>{
 if(!e.target.dataset.cat)return;
 category=e.target.dataset.cat;
 document.querySelectorAll("#tabs button").forEach(b=>b.classList.toggle("active",b===e.target));
 showMenu();
});
document.getElementById("search").addEventListener("input",showMenu);
document.getElementById("promoTabs").addEventListener("click",e=>{
 if(!e.target.dataset.filter)return;
 promoCategory=e.target.dataset.filter;
 document.querySelectorAll("#promoTabs button").forEach(b=>b.classList.toggle("active",b===e.target));
 showPromos();
});

const date=document.getElementById("date");
const now=new Date();
now.setMinutes(now.getMinutes()-now.getTimezoneOffset());
date.min=now.toISOString().slice(0,10);

const time=document.getElementById("time");
for(let h=9;h<=19;h++){
 for(let m of [0,30]){
  if(h===9&&m===0)continue;
  if(h===19&&m>30)continue;
  let value=String(h).padStart(2,"0")+":"+String(m).padStart(2,"0");
  let d=new Date();d.setHours(h,m);
  let option=document.createElement("option");
  option.value=value;
  option.textContent=d.toLocaleTimeString("en-PH",{hour:"numeric",minute:"2-digit"});
  time.appendChild(option);
 }
}

document.getElementById("orderForm").addEventListener("submit",async e=>{
 e.preventDefault();
 const status=document.getElementById("status");
 if(!countItems()){status.textContent="Please add items to your cart first.";return;}
 const customer=document.getElementById("customer").value.trim();
 const phone=document.getElementById("phone").value.trim();
 const pickupDate=date.value;
 const pickupTime=time.value;
 if(!customer||!phone||!pickupDate||!pickupTime){status.textContent="Please complete all required details.";return;}
 const pickup=new Date(pickupDate+"T"+pickupTime+":00");
 if(pickup<new Date()){status.textContent="Please choose a future pickup time.";return;}
 const lines=products.filter(p=>cart[p[0]]).map(p=>`- ${p[1]} x${cart[p[0]]} = ${money(p[2]*cart[p[0]])}`);
 const dateText=new Date(pickupDate+"T12:00:00").toLocaleDateString("en-PH",{year:"numeric",month:"long",day:"numeric"});
 const message=`Hello, Friedays! I would like to place an advance order request.\n\nName: ${customer}\nContact: ${phone}\nPreferred pickup: ${dateText}, ${pickupTime}\n\nORDER:\n${lines.join("\n")}\n\nEstimated total: ${money(totalPrice())}\nNotes: ${document.getElementById("notes").value}\n\nPlease confirm availability and pickup schedule. Thank you!`;
 status.textContent="Copying your order details and opening the Friedays Facebook page. Paste the message into Messenger and send it.";
 try{await navigator.clipboard.writeText(message);}
 catch(err){status.textContent="Clipboard access unavailable. Please note your cart details and message Friedays.";}
 window.open(FACEBOOK,"_blank","noopener");
});

document.getElementById("year").textContent=new Date().getFullYear();
showMenu();
showCart();
showPromos();
</script>
</body>
</html>
